<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/developer_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/title" style="@style/DashboardHeading"
            android:text="@string/developer_mode" android:textSize="32sp" />
        

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_camera" style="@style/DashboardHeading" android:text="@string/section_camera" />
            <TextView android:id="@+id/camera_status" style="@style/DashboardText" android:text="@string/camera_status" />
            <Button android:id="@+id/use_phone_camera" style="@style/DashboardButton" android:text="@string/phone_preview_start" />
            <TextView style="@style/DashboardText" android:text="@string/phone_preview_help" />
            <com.guideeye.app.vision.DetectionPreview android:id="@+id/camera_preview"
                android:layout_width="match_parent" android:layout_height="260dp"
                android:background="#142532" android:importantForAccessibility="no" />
            <TextView android:id="@+id/video" style="@style/DashboardText" android:background="@drawable/bg_notice"
                android:padding="20dp" android:gravity="center" android:text="@string/video_placeholder" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_connection" style="@style/DashboardHeading" android:text="@string/section_connection" />
            <TextView android:id="@+id/notice" style="@style/DashboardText"
                android:background="@drawable/bg_notice" android:padding="16dp"
                android:textColor="@color/text_primary" android:text="@string/mock_notice" />
            <TextView android:id="@+id/mock_status" style="@style/DashboardText" android:text="@string/mock_running" />
            <TextView android:id="@+id/sensor_status" style="@style/DashboardText" android:text="@string/sensor_status" />
            <Button android:id="@+id/connect_usb" style="@style/DashboardButton.Primary" android:text="@string/usb_connect" />
            <Button android:id="@+id/use_mock" style="@style/DashboardButton" android:text="@string/usb_mock" />
            <Button android:id="@+id/toggle_mock" style="@style/DashboardButton" android:text="@string/pause_mock" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard" android:visibility="gone">
            <TextView android:id="@+id/heading_distance" style="@style/DashboardHeading" android:text="@string/section_distance" />
            <TextView android:id="@+id/left_distance" style="@style/DashboardDistance" android:text="@string/left_waiting" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_border"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/right_distance" style="@style/DashboardDistance" android:text="@string/right_waiting" />
            <Button android:id="@+id/toggle_distance_tone" style="@style/DashboardButton"
                android:text="@string/distance_tone_enable" />
            <TextView android:id="@+id/distance_tone_status" style="@style/DashboardText"
                android:text="@string/distance_tone_off" />
            <TextView android:id="@+id/distance_tone_target" style="@style/DashboardText"
                android:text="@string/distance_tone_no_target" />
            <TextView style="@style/DashboardText" android:text="@string/distance_tone_help" />
            <TextView android:id="@+id/risk" style="@style/DashboardText" android:text="@string/risk_pending" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView style="@style/DashboardHeading" android:text="@string/tof_grid_heading" />

            <TextView style="@style/DashboardText" android:text="@string/tof_rotation_a" android:visibility="gone" />
            <Spinner android:id="@+id/tof_rotation_a" android:layout_width="match_parent" android:layout_height="64dp" android:saveEnabled="false" android:visibility="gone" />
            <CheckBox android:id="@+id/tof_mirror_a" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/tof_mirror_a" android:saveEnabled="false" android:visibility="gone" />
            <TextView style="@style/DashboardText" android:text="@string/tof_rotation_b" android:visibility="gone" />
            <Spinner android:id="@+id/tof_rotation_b" android:layout_width="match_parent" android:layout_height="64dp" android:saveEnabled="false" android:visibility="gone" />
            <CheckBox android:id="@+id/tof_mirror_b" android:layout_width="match_parent" android:layout_height="64dp" android:text="@string/tof_mirror_b" android:saveEnabled="false" android:visibility="gone" />
            <TextView android:id="@+id/tof_grid_waiting" style="@style/DashboardText"
                android:text="@string/tof_grid_waiting" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView style="@style/DashboardText" android:text="A 왼쪽 센서 (mm)" />
                    <GridLayout android:id="@+id/tof_grid_a" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:columnCount="8" android:rowCount="8" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/DashboardText" android:text="B 오른쪽 센서 (mm)" />
                    <GridLayout android:id="@+id/tof_grid_b" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:columnCount="8" android:rowCount="8" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/DashboardText"
                android:text="거리 색상(mm): 빨강 1~100 · 주황 101~200 · 노랑 201~300 · 연두 301~500 · 초록 501~1000 · 파랑 1001~4000 · 회색 측정 불가" />
            <CheckBox android:id="@+id/tof_mount_confirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/tof_mount_confirm" android:saveEnabled="false" android:visibility="gone" />
            <Button android:id="@+id/tof_spatial_toggle" style="@style/DashboardButton" android:text="@string/tof_spatial_enable" android:visibility="gone" />
            <TextView android:id="@+id/tof_spatial_status" style="@style/DashboardText" android:text="@string/hrtf_preparing" android:visibility="gone" />
            <TextView android:id="@+id/tof_spatial_target" style="@style/DashboardText" android:text="@string/distance_tone_no_target" android:visibility="gone" />
            <TextView style="@style/DashboardHeading" android:text="@string/radar_heading" android:visibility="gone" />
            <TextView style="@style/DashboardText" android:text="@string/radar_help" android:visibility="gone" />
            <TextView style="@style/DashboardText" android:text="@string/radar_limit_label" android:visibility="gone" />
            <Spinner android:id="@+id/radar_limit" android:layout_width="match_parent" android:layout_height="64dp" android:saveEnabled="false" android:visibility="gone" />
            <Button android:id="@+id/radar_toggle" style="@style/DashboardButton" android:text="@string/radar_enable" android:visibility="gone" />
            <TextView android:id="@+id/radar_status" style="@style/DashboardText" android:text="@string/hrtf_preparing" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard" android:visibility="gone">
            <TextView android:id="@+id/heading_hrtf" style="@style/DashboardHeading" android:text="@string/hrtf_heading" />
            <TextView style="@style/DashboardText" android:text="@string/hrtf_help" />
            <TextView android:id="@+id/hrtf_status" style="@style/DashboardText" android:text="@string/hrtf_preparing" />
            <TextView android:id="@+id/hrtf_distance_label" style="@style/DashboardText" android:text="@string/hrtf_initial_distance" />
            <SeekBar android:id="@+id/hrtf_distance" android:layout_width="match_parent" android:layout_height="64dp"
                android:max="3800" android:progress="1800" android:saveEnabled="false" android:contentDescription="@string/hrtf_distance_description" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/hrtf_front" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_front" />
                <Button android:id="@+id/hrtf_back" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_back" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/hrtf_left" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_left" />
                <Button android:id="@+id/hrtf_right" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_right" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/hrtf_front_left" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_front_left" />
                <Button android:id="@+id/hrtf_front_right" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_front_right" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/hrtf_back_left" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_back_left" />
                <Button android:id="@+id/hrtf_back_right" style="@style/DashboardButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/hrtf_back_right" />
            </LinearLayout>
            <Button android:id="@+id/hrtf_circle" style="@style/DashboardButton" android:text="@string/hrtf_circle" />
            <Button android:id="@+id/hrtf_stop" style="@style/DashboardButton" android:text="@string/hrtf_stop" />
            <TextView style="@style/DashboardText" android:text="@string/hrtf_attribution" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard" android:visibility="gone">
            <TextView android:id="@+id/heading_voice" style="@style/DashboardHeading" android:text="@string/section_voice" />
            <TextView style="@style/DashboardText" android:text="@string/touch_instructions" />
            <TextView android:id="@+id/tts_status" style="@style/DashboardText" android:text="@string/tts_initializing" />
            <Button android:id="@+id/speech_test" style="@style/DashboardButton.Primary" android:text="@string/speech_test" />
            <TextView style="@style/DashboardText" android:layout_marginTop="16dp" android:text="@string/accessibility_instructions" />
            <TextView android:id="@+id/recent_speech" style="@style/DashboardText" android:layout_marginTop="16dp"
                android:text="@string/speech_idle" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView style="@style/DashboardHeading" android:text="전체 알고리즘 테스트" />
            <TextView style="@style/DashboardText"
                android:text="현재 실행 중인 단계가 알고리즘 그림 위에 표시됩니다." />
            <Button android:id="@+id/full_test_toggle" style="@style/DashboardButton.Primary"
                android:text="전체 테스트 시작" />
            <TextView android:id="@+id/full_test_status" style="@style/DashboardText"
                android:text="테스트 대기" />
            <LinearLayout android:id="@+id/full_test_blocks"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <com.guideeye.app.AlgorithmFlowView android:id="@+id/algorithm_flow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layerType="software" />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</ScrollView>
