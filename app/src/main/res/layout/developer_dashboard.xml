<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/developer_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/title" style="@style/DashboardHeading"
            android:text="@string/developer_mode" android:textSize="32sp" />
        <TextView android:id="@+id/subtitle" style="@style/DashboardText" android:text="@string/subtitle" />

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_camera" style="@style/DashboardHeading" android:text="@string/section_camera" />
            <TextView android:id="@+id/camera_status" style="@style/DashboardText" android:text="@string/camera_status" />
            <Button android:id="@+id/use_phone_camera" style="@style/DashboardButton" android:text="@string/phone_preview_start" />
            <TextView style="@style/DashboardText" android:text="@string/phone_preview_help" />
            <com.guideeye.app.vision.DetectionPreview android:id="@+id/camera_preview"
                android:layout_width="match_parent" android:layout_height="260dp"
                android:background="#142532" android:importantForAccessibility="no" />
            <TextView android:id="@+id/video" style="@style/DashboardText" android:background="@drawable/bg_notice"
                android:padding="20dp" android:gravity="center" android:text="@string/video_placeholder" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_connection" style="@style/DashboardHeading" android:text="@string/section_connection" />
            <TextView android:id="@+id/notice" style="@style/DashboardText"
                android:background="@drawable/bg_notice" android:padding="16dp"
                android:textColor="@color/text_primary" android:text="@string/mock_notice" />
            <TextView android:id="@+id/mock_status" style="@style/DashboardText" android:text="@string/mock_running" />
            <TextView android:id="@+id/sensor_status" style="@style/DashboardText" android:text="@string/sensor_status" />
            <Button android:id="@+id/connect_usb" style="@style/DashboardButton.Primary" android:text="@string/usb_connect" />
            <Button android:id="@+id/use_mock" style="@style/DashboardButton" android:text="@string/usb_mock" />
            <Button android:id="@+id/toggle_mock" style="@style/DashboardButton" android:text="@string/pause_mock" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_distance" style="@style/DashboardHeading" android:text="@string/section_distance" />
            <TextView android:id="@+id/left_distance" style="@style/DashboardDistance" android:text="@string/left_waiting" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/surface_border"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/right_distance" style="@style/DashboardDistance" android:text="@string/right_waiting" />
            <Button android:id="@+id/toggle_distance_tone" style="@style/DashboardButton"
                android:text="@string/distance_tone_enable" />
            <TextView android:id="@+id/distance_tone_status" style="@style/DashboardText"
                android:text="@string/distance_tone_off" />
            <TextView style="@style/DashboardText" android:text="@string/distance_tone_help" />
            <TextView android:id="@+id/risk" style="@style/DashboardText" android:text="@string/risk_pending" />
        </LinearLayout>

        <LinearLayout style="@style/DashboardCard">
            <TextView android:id="@+id/heading_voice" style="@style/DashboardHeading" android:text="@string/section_voice" />
            <TextView style="@style/DashboardText" android:text="@string/touch_instructions" />
            <TextView android:id="@+id/tts_status" style="@style/DashboardText" android:text="@string/tts_initializing" />
            <Button android:id="@+id/speech_test" style="@style/DashboardButton.Primary" android:text="@string/speech_test" />
            <TextView style="@style/DashboardText" android:layout_marginTop="16dp" android:text="@string/accessibility_instructions" />
            <TextView android:id="@+id/recent_speech" style="@style/DashboardText" android:layout_marginTop="16dp"
                android:text="@string/speech_idle" />
        </LinearLayout>


    </LinearLayout>
</ScrollView>
