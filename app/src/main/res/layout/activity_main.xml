<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="32sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subtitle" android:textSize="18sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/mock_notice" android:textSize="20sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/camera_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/camera_status" android:textSize="20sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/sensor_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sensor_status" android:textSize="20sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/video" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/video_placeholder" android:textSize="18sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/mock_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/mock_running" android:textSize="18sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/left_distance" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/left_waiting" android:textSize="26sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/right_distance" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/right_waiting" android:textSize="26sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/risk" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/risk_pending" android:textSize="20sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/tts_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tts_initializing" android:textSize="18sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <TextView android:id="@+id/recent_speech" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/speech_idle" android:textSize="18sp" android:textColor="#172533" android:paddingBottom="16dp" />
        <Button android:id="@+id/connect_usb" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="64dp" android:text="@string/usb_connect" android:textSize="20sp" />
        <Button android:id="@+id/use_mock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="64dp" android:text="@string/usb_mock" android:textSize="20sp" />
        <Button android:id="@+id/toggle_mock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="64dp" android:text="@string/pause_mock" android:textSize="20sp" />
        <Button android:id="@+id/speech_test" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="64dp" android:text="@string/speech_test" android:textSize="20sp" />
    </LinearLayout>
</ScrollView>
