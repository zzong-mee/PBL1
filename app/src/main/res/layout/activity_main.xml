<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/home_title" style="@style/DashboardHeading"
            android:text="@string/app_name" android:textSize="32sp" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/home_voice_status" style="@style/DashboardText"
            android:text="@string/tts_initializing" android:textSize="16sp" android:layout_marginBottom="12dp"
            android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface"
            android:layout_marginBottom="16dp">
            <TextView android:id="@+id/home_status_label" style="@style/DashboardText"
                android:text="@string/home_status_label" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/home_operation_status" style="@style/DashboardHeading"
                android:text="@string/operation_waiting" android:textSize="24sp"
                android:accessibilityLiveRegion="polite" android:layout_marginBottom="0dp" />
        </LinearLayout>
        <Button android:id="@+id/listen_status" style="@style/DashboardButton.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp"
            android:textSize="30sp" android:text="@string/central_object" android:contentDescription="@string/central_object_description"
            android:drawableTop="@drawable/ic_center_object" android:drawablePadding="10dp" android:enabled="false" />
        <Button android:id="@+id/listen_help" style="@style/DashboardButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp"
            android:textSize="22sp" android:text="@string/pause_operation" android:drawablePadding="8dp" />
        <Button android:id="@+id/listen_howto" style="@style/DashboardButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            android:textSize="19sp" android:text="@string/listen_howto" />
        <Button android:id="@+id/open_developer" style="@style/DashboardButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:textSize="16sp" android:padding="12dp" android:text="@string/developer_mode"
            android:contentDescription="@string/developer_mode_description" />
    </LinearLayout>
</ScrollView>
